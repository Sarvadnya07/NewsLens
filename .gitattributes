# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Python source files
*.py text eol=lf diff=python
*.pyi text eol=lf diff=python
*.toml text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.css text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Windows-specific scripts
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary artifacts (do not attempt line-ending normalization or text diffs)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.joblib binary
*.pkl binary
*.pickle binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.pyc binary
