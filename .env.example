# NewsLens India - Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Ingestion Provider API Credentials
# NewsData.io Latest News API Key (https://newsdata.io)
# Header authentication: X-ACCESS-KEY
NEWSDATA_API_KEY=

# Storage and Data Paths (defaults point to repository data directory)
# NEWSLENS_DB_PATH=data/newslens.db
# NEWSLENS_FACT_CHECKS_PATH=data/fact_checks.json

# API Server Settings
# PORT=8000
# HOST=127.0.0.1
