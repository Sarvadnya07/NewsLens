
# ==========================================
# NEWSLENS INDIA - CENTRAL ENVIRONMENT CONFIGURATION
# Tagline: See coverage. Examine evidence.
# ==========================================
# Copy this file to .env at the repository root and populate credentials.
# Restart the FastAPI backend after modifying .env.

# ==========================================
# CORE APPLICATION SETTINGS
# ==========================================
APP_ENV=development
APP_DEBUG=false
NEWSLENS_DB_PATH=data/newslens.db
NEWSLENS_FACT_CHECKS_PATH=data/fact_checks.json

# ==========================================
# EXISTING AGGREGATOR: NEWSDATA.IO
# Register: https://newsdata.io
# Header auth: X-ACCESS-KEY
# ==========================================
NEWSDATA_ENABLED=true
NEWSDATA_API_KEY=
NEWSDATA_DAILY_BUDGET=50
NEWSDATA_15MIN_BUDGET=10
NEWSDATA_MIN_REFRESH_INTERVAL=60.0
NEWSDATA_MAX_PAGES=2

# ==========================================
# EXISTING GLOBAL DISCOVERY: GDELT 2.0 DOC API
# No API key required. Public rate limit enforced (5.0s backoff).
# ==========================================
GDELT_ENABLED=true

# ==========================================
# ADDITIONAL AGGREGATOR: CURRENTS API
# Register: https://currentsapi.services
# Header auth: Authorization: <API_KEY>
# Free allowance: 250 requests/day, 20 results/req
# ==========================================
CURRENTS_ENABLED=false
CURRENTS_API_KEY=
CURRENTS_DAILY_BUDGET=250
CURRENTS_15MIN_BUDGET=25
CURRENTS_MIN_REFRESH_INTERVAL=60.0
CURRENTS_DEFAULT_MAX_PAGES=1

# ==========================================
# FACT-CHECK EVIDENCE: GOOGLE FACT CHECK TOOLS API
# Register: https://console.cloud.google.com
# Enable "Fact Check Tools API" in Google Cloud Console
# Param auth: key=<API_KEY>
# Free allowance: Generous standard GCP quota (up to 10,000 queries/day)
# ==========================================
GOOGLE_FACTCHECK_ENABLED=false
GOOGLE_FACTCHECK_API_KEY=
GOOGLE_FACTCHECK_DAILY_BUDGET=500
GOOGLE_FACTCHECK_MIN_REFRESH_INTERVAL=5.0

# ==========================================
# FIRST-PARTY PUBLISHER: THE GUARDIAN OPEN PLATFORM
# Register: https://open-platform.theguardian.com/access/
# Param auth: api-key=<API_KEY>
# Developer tier: 500 requests/day, 1 req/sec throttle, non-commercial only
# ==========================================
GUARDIAN_ENABLED=false
GUARDIAN_API_KEY=
GUARDIAN_DAILY_BUDGET=500
GUARDIAN_15MIN_BUDGET=50
GUARDIAN_MIN_REFRESH_INTERVAL=5.0
GUARDIAN_DEFAULT_MAX_PAGES=2

# ==========================================
# OFFICIAL AND REGIONAL RSS FEEDS (Zero Credentials Required)
# Direct XML syndication from verified publisher endpoints
# ==========================================
PIB_ENABLED=true
ABP_RSS_ENABLED=true
AMAR_UJALA_RSS_ENABLED=true

# ==========================================
# DOCUMENTED BACKLOG INTEGRATIONS (Optional / Inactive)
# Populate keys when ready to integrate.
# ==========================================
# The New York Times APIs (https://developer.nytimes.com)
NYT_ENABLED=false
NYT_API_KEY=

# Brave News Search API (https://brave.com/search/api/)
BRAVE_ENABLED=false
BRAVE_API_KEY=

# ==========================================
# GLOBAL INTEGRATION TIMEOUTS & SECURITY
# ==========================================
INTEGRATION_REQUEST_TIMEOUT=20.0
INTEGRATION_MAX_RETRIES=2
INTEGRATION_DEFAULT_MAX_PAGES=2
INTEGRATION_MAX_CONCURRENT_REQUESTS=3
INTEGRATION_LOG_SECRETS=false
